# Base PostgreSQL. Neon en prod, local en dev.
DATABASE_URL=postgresql://user:password@host:5432/site

# Clé Payload. openssl rand -hex 32
PAYLOAD_SECRET=

# Stockage des médias. Vercel Dashboard, Storage, Blob.
BLOB_READ_WRITE_TOKEN=

# Emails. resend.com
RESEND_API_KEY=

# URL publique. Obligatoire en production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Protège les routes /api/cron. openssl rand -hex 32
CRON_SECRET=
